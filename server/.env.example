# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_test?schema=public"

# Direct (unpooled) connection, used for migrations. Required, always.
# - No pooler (local, Docker): set it to the same value as DATABASE_URL.
# - Behind a pooler: use the direct endpoint instead.
#     Neon     — same host without `-pooler`
#     Supabase — port 5432 rather than 6543
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sms?schema=public"

# Hosted Postgres notes:
#   Neon  — append ?sslmode=require&pgbouncer=true to DATABASE_URL, and
#           ?sslmode=require to DIRECT_URL. Do NOT include channel_binding,
#           which Prisma's connector does not support.
#   Render — prefer the Internal Database URL when the API is in the same region.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# How this installation is sold and run:
#   saas       — one deployment serving many schools, with platform
#                administration and subscription plan limits.
#   standalone — a single school that owns its installation. Platform
#                administration is not mounted and plan limits do not apply.
# Create the first school on a standalone install with: npm run bootstrap
DEPLOYMENT_MODE=saas

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# --- Integrations (section 7) ----------------------------------------------
# SMS. `none` (the default) records messages in the outbox without sending —
# a development machine never spends credit or texts a real parent. Email has
# no transport yet, so it stays in the outbox whatever SMTP_* says.
SMS_PROVIDER=none
SMS_SENDER_ID=SCHOOL
SMS_MAX_ATTEMPTS=3

# Africa's Talking. Sandbox uses the username "sandbox" and its own API key
# from the sandbox dashboard; live requires a registered alphanumeric sender ID.
#
# There is no URL to set — the flag below picks between the sandbox and live
# hosts. The sandbox rejects sender IDs outright, so with it on, set
# SMS_SENDER_ID= (blank) and clear the school's own under Settings, or every
# send comes back InvalidSenderId.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SANDBOX=false
# Overrides the endpoint entirely — an outbound proxy, or a stub in testing.
# Not needed for the sandbox.
# AFRICASTALKING_BASE_URL=

# Email. `none` (the default) records messages in the outbox without sending.
# `smtp` needs SMTP_HOST and SMTP_FROM at minimum — credentials are optional,
# since an internal relay often accepts mail without them.
EMAIL_PROVIDER=none
EMAIL_MAX_ATTEMPTS=3

SMTP_HOST=
# 587 with STARTTLS is the usual choice. Port 465 is TLS from the first byte
# and needs SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# The address every school sends from. Only the display name changes per
# school, so that SPF and DKIM stay aligned with this domain; replies are
# pointed at the school's own address from Settings.
SMTP_FROM="School Management System <no-reply@example.ac.tz>"

# Mobile money (M-Pesa, Airtel Money, Mixx by Yas, HaloPesa)
MOBILE_MONEY_WEBHOOK_SECRET=

# Vodacom M-Pesa (OpenAPI). Needed to charge a school during registration;
# until these are set, M-Pesa stays a payment method that is only recorded by
# hand, with no live charge.
#
# All three come from the M-Pesa OpenAPI portal at
# https://openapiportal.m-pesa.com — register, create an application, and
# subscribe it to the Customer-to-Business product. The portal shows an API
# key and a public key per application, and they are per environment: the
# sandbox pair does not work against live.
#
# MPESA_API_KEY   — the application's API key. It is not sent as-is: it is
#                   RSA-encrypted with MPESA_PUBLIC_KEY to make the bearer
#                   token for getSession, which returns the session id that
#                   every later call uses.
# MPESA_PUBLIC_KEY— the base64 public key from the same page, as one line with
#                   no PEM header or line breaks.
# MPESA_SERVICE_PROVIDER_CODE
#                 — the paying-in short code. The sandbox uses 000000; live is
#                   the code Vodacom issues with the merchant account.
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=000000

# Which M-Pesa environment to talk to. The sandbox and live hosts differ only
# in their path prefix (/sandbox/ipg/v2/vodacomTZN/ against
# /openapi/ipg/v2/vodacomTZN/), so this flag picks the prefix rather than a URL.
MPESA_SANDBOX=true
# The market segment in that path. Tanzania is vodacomTZN; Lesotho, Ghana and
# the DRC each have their own.
MPESA_MARKET=vodacomTZN

# --- Storage ----------------------------------------------------------------
#
# Where uploaded files go: student photographs, scanned birth certificates,
# staff contracts.
#
#   local — the filesystem at STORAGE_LOCAL_PATH. No credentials, works out of
#           the box, and correct for development or a single server with a real
#           disk. Not usable across two API instances: each would hold half the
#           files.
#   r2    — Cloudflare R2. The choice for a deployment: reads cost no egress,
#           which matters when every parent opening a report card pulls a
#           photograph.
#   s3    — any other S3-compatible bucket (AWS, MinIO, Wasabi). Same driver as
#           r2, but set S3_ENDPOINT and S3_REGION yourself.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# The largest single upload, in MB. This also bounds how much memory one
# request can take, since uploads are buffered before being forwarded.
STORAGE_MAX_UPLOAD_MB=10
# How long a download link stays valid. It is a bearer credential for one
# file, so minutes rather than days.
STORAGE_URL_TTL_SECONDS=300

# Cloudflare R2. Create the bucket, then R2 -> Manage API tokens -> Create API
# token, scoped to *Object Read & Write* on this bucket alone.
# R2_ACCOUNT_ID is on the R2 overview page; it forms the endpoint
# https://<account id>.r2.cloudflarestorage.com.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Only for STORAGE_DRIVER=s3, or to point r2 somewhere else in testing.
S3_ENDPOINT=
# R2 ignores the region, but the signing algorithm needs a value.
S3_REGION=auto
# MinIO generally needs this on; R2 and AWS do not.
S3_FORCE_PATH_STYLE=false
