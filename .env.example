# Copy to .env before running `docker compose up`.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=sms
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=sms

# --- Auth secrets -----------------------------------------------------------
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Deployment mode --------------------------------------------------------
# saas       = one deployment serving many schools (platform admin + plan limits)
# standalone = a single school that owns its installation (neither applies)
DEPLOYMENT_MODE=saas

# --- Web --------------------------------------------------------------------
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080

# --- Integrations (optional; blank = messages are logged, not dispatched) ---
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=SCHOOL

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="School Management System <no-reply@example.ac.tz>"
