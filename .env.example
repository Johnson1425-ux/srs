# Copy to .env before running `docker compose up`.

# --- Database ---------------------------------------------------------------
# This password goes into a connection URL, so keep it to letters, digits,
# hyphens and underscores. A "/" makes the URL invalid outright and "@" or "#"
# will be read as the start of the host or a comment.
#   Generate a safe one with: openssl rand -hex 32
#
# It is only applied when the database volume is FIRST created. Changing it
# later has no effect until you run `docker compose down -v`, which deletes
# the database along with the volume.
POSTGRES_USER=sms
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=sms

# --- Auth secrets -----------------------------------------------------------
# Generate each with: openssl rand -base64 48
# These are not part of a URL, so any characters are fine here.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Deployment mode --------------------------------------------------------
# saas       = one deployment serving many schools (platform admin + plan limits)
# standalone = a single school that owns its installation (neither applies)
DEPLOYMENT_MODE=saas

# --- Web --------------------------------------------------------------------
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080
# The address parents reach the app on, used to build the results links texted
# to them. Defaults to the first CORS_ORIGIN. Every character is billed in every
# message, so a short host is worth having.
PUBLIC_WEB_URL=
# How long a texted results link keeps working.
RESULT_LINK_TTL_DAYS=120

# --- Integrations (optional; `none` = messages are logged, not dispatched) ---
# `africastalking` or `nextsms` — fill in only the block for the one you pick.
SMS_PROVIDER=none
SMS_SENDER_ID=SCHOOL
SMS_MAX_ATTEMPTS=3

AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# No URL to set: this flag picks between the sandbox and live hosts. The
# sandbox rejects sender IDs, so with it on leave SMS_SENDER_ID blank.
AFRICASTALKING_SANDBOX=false

# NextSMS (messaging-service.co.tz). Either paste the authorization token from
# their dashboard (with or without its `Basic ` prefix)...
NEXTSMS_AUTH_TOKEN=
# ...or give the same credentials unencoded. The token wins if both are set.
NEXTSMS_USERNAME=
NEXTSMS_PASSWORD=
# Validates each request and reports back without delivering or billing.
NEXTSMS_TEST_MODE=false

# `smtp` needs SMTP_HOST and SMTP_FROM; SMTP_SECURE=true only for port 465.
EMAIL_PROVIDER=none
EMAIL_MAX_ATTEMPTS=3
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="School Management System <no-reply@example.ac.tz>"

# --- Storage ----------------------------------------------------------------
#
# Where uploaded files go: student photographs, scanned birth certificates,
# staff contracts.
#
#   local — the filesystem at STORAGE_LOCAL_PATH. No credentials, works out of
#           the box, and correct for development or a single server with a real
#           disk. Not usable across two API instances: each would hold half the
#           files.
#   r2    — Cloudflare R2. The choice for a deployment: reads cost no egress,
#           which matters when every parent opening a report card pulls a
#           photograph.
#   s3    — any other S3-compatible bucket (AWS, MinIO, Wasabi). Same driver as
#           r2, but set S3_ENDPOINT and S3_REGION yourself.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# The largest single upload, in MB. This also bounds how much memory one
# request can take, since uploads are buffered before being forwarded.
STORAGE_MAX_UPLOAD_MB=10
# How long a download link stays valid. It is a bearer credential for one
# file, so minutes rather than days.
STORAGE_URL_TTL_SECONDS=300

# Cloudflare R2. Create the bucket, then R2 -> Manage API tokens -> Create API
# token, scoped to *Object Read & Write* on this bucket alone.
# R2_ACCOUNT_ID is on the R2 overview page; it forms the endpoint
# https://<account id>.r2.cloudflarestorage.com.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Only for STORAGE_DRIVER=s3, or to point r2 somewhere else in testing.
S3_ENDPOINT=
# R2 ignores the region, but the signing algorithm needs a value.
S3_REGION=auto
# MinIO generally needs this on; R2 and AWS do not.
S3_FORCE_PATH_STYLE=false
